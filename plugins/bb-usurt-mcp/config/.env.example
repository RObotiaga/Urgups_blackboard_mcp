# Blackboard account for the independent HTTP session.
# The MCP server reads this file locally and never returns these values from tools.

# Primary / single account (backwards compatible):
BB_USURT_USERNAME=
BB_USURT_PASSWORD=
# Optional record book number (номер зачётной книжки для report.usurt.ru)
BB_USURT_RECORD_BOOK=

# Multi-account configuration option 1: Named environment variables
# You can define multiple accounts by prefixing BB_ACCOUNT_<ID>_USERNAME and BB_ACCOUNT_<ID>_PASSWORD:
# BB_ACCOUNT_STUDENT1_USERNAME=
# BB_ACCOUNT_STUDENT1_PASSWORD=
# BB_ACCOUNT_STUDENT1_RECORD_BOOK=
# BB_ACCOUNT_STUDENT2_USERNAME=
# BB_ACCOUNT_STUDENT2_PASSWORD=
# BB_ACCOUNT_STUDENT2_RECORD_BOOK=

# Optional: set which account is active by default (if omitted, the first configured account is active)
# BB_USURT_DEFAULT_ACCOUNT=student1

# Multi-account configuration option 2: JSON in config/accounts.json (see config/accounts.example.json)
# Multi-account configuration option 3: JSON string in BB_ACCOUNTS
# BB_ACCOUNTS='[{"id":"student1","username":"...","password":"..."},{"id":"student2","username":"...","password":"..."}]'

# Optional absolute download directory. Default: <package>/downloads
# BB_USURT_DOWNLOAD_DIR=

# Transport defaults: Chrome 152 / Windows profile; use browser-observed HTTP/1.1.
# BB_USURT_BROWSER_PROFILE=chrome-152-windows
# BB_USURT_HTTP_VERSION=h1
