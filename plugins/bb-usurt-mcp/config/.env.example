# Blackboard account for the independent HTTP session.
# The MCP server reads this file locally and never returns these values from tools.
BB_USURT_USERNAME=
BB_USURT_PASSWORD=

# Optional absolute download directory. Default: <package>/downloads
# BB_USURT_DOWNLOAD_DIR=

# Transport defaults: Chrome 152 / Windows profile; use browser-observed HTTP/1.1.
# BB_USURT_BROWSER_PROFILE=chrome-152-windows
# BB_USURT_HTTP_VERSION=h1
